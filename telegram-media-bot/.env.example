# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Ключ Claude API: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Кому разрешено пользоваться ботом (ваш Telegram user id, через запятую).
# Пусто = всем (НЕ рекомендуется: платите за запросы вы). Свой id бот покажет на /start.
ALLOWED_USER_IDS=
# Необязательно:
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
DATA_DIR=./data
# Свой шрифт для подписей на видео (путь к .ttf); по умолчанию ищется автоматически
FONT_FILE=
# Распознавание голосовых (нужен faster-whisper, см. README)
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru
